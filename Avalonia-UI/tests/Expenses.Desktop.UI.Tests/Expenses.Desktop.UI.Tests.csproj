<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The ledger and the picker are faked the same way the view-model suite fakes them: the files
       are shared by link, so there is one fake of the HTTP interface, not two drifting apart. -->
  <ItemGroup>
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FakeHttpMessageHandler.cs" Link="Fakes\FakeHttpMessageHandler.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\RecordedRequest.cs" Link="Fakes\RecordedRequest.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FakeImagePicker.cs" Link="Fakes\FakeImagePicker.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\Purchases.cs" Link="Fakes\Purchases.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\Captures.cs" Link="Fakes\Captures.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FixedClock.cs" Link="Fakes\FixedClock.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Expenses.Desktop\Expenses.Desktop.csproj" />
  </ItemGroup>

</Project>
