<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The same harness the UI suite drives the window with; here it runs against the real ledger. -->
  <ItemGroup>
    <Compile Include="..\Expenses.Desktop.UI.Tests\Harness\DesktopHarness.cs" Link="Harness\DesktopHarness.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FakeHttpMessageHandler.cs" Link="Fakes\FakeHttpMessageHandler.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\RecordedRequest.cs" Link="Fakes\RecordedRequest.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FakeImagePicker.cs" Link="Fakes\FakeImagePicker.cs" />
    <Compile Include="..\Expenses.Desktop.Core.Tests\Fakes\FixedClock.cs" Link="Fakes\FixedClock.cs" />
  </ItemGroup>

  <!-- The browser client's end-to-end receipt, used by path rather than copied, so both clients are
       proved against the same photograph. -->
  <ItemGroup>
    <None Include="..\..\..\FE\e2e\fixtures\receipt.jpg" Link="Fixtures\receipt.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Expenses.Desktop\Expenses.Desktop.csproj" />
  </ItemGroup>

</Project>
