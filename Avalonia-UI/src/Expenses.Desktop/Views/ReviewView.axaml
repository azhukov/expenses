<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Expenses.Desktop.Core.Screens"
             x:Class="Expenses.Desktop.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="ReviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="24,16">
      <TextBlock x:Name="FailureReason"
                 Text="{Binding FailureReason}"
                 IsVisible="{Binding FailureReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />

      <!-- Why review is needed, in the response's own words rather than a generic warning. -->
      <ItemsControl x:Name="ReviewReasons" ItemsSource="{Binding Reasons}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock x:Name="ReviewReason" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="Rejection"
                 Text="{Binding Rejection}"
                 IsVisible="{Binding Rejection, Converter={x:Static ObjectConverters.IsNotNull}}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />

      <WrapPanel x:Name="Header" ItemSpacing="12" LineSpacing="8">
        <StackPanel MinWidth="220">
          <TextBlock Classes="label" Text="Merchant" />
          <TextBox x:Name="Merchant" Text="{Binding Merchant}" AutomationProperties.Name="Merchant" />
        </StackPanel>
        <StackPanel MinWidth="180">
          <TextBlock Classes="label" Text="Date" />
          <TextBox x:Name="OccurredAt" Text="{Binding OccurredAt}" PlaceholderText="yyyy-MM-dd HH:mm" AutomationProperties.Name="Date, as year-month-day and time" />
        </StackPanel>
        <StackPanel MinWidth="120">
          <TextBlock Classes="label" Text="Total amount" />
          <TextBox x:Name="Amount" Text="{Binding Amount}" AutomationProperties.Name="Total amount" />
        </StackPanel>
      </WrapPanel>

      <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EditableLineViewModel">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,8">
              <StackPanel Spacing="6">
                <TextBlock x:Name="LineUnsure"
                           Text="{Binding Unsure}"
                           IsVisible="{Binding Unsure, Converter={x:Static ObjectConverters.IsNotNull}}"
                           FontStyle="Italic"
                           TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                  <StackPanel MinWidth="200">
                    <TextBlock Classes="label" Text="Description" />
                    <TextBox x:Name="LineDescription" Text="{Binding Description}" TextWrapping="Wrap" AutomationProperties.Name="Line description" />
                  </StackPanel>
                  <StackPanel MinWidth="100">
                    <TextBlock Classes="label" Text="Amount" />
                    <TextBox x:Name="LineAmount" Text="{Binding Amount}" AutomationProperties.Name="Line amount" />
                  </StackPanel>
                  <StackPanel MinWidth="100">
                    <TextBlock Classes="label" Text="Quantity" />
                    <TextBox x:Name="LineQuantity" Text="{Binding Quantity}" AutomationProperties.Name="Line quantity" />
                  </StackPanel>
                  <StackPanel MinWidth="160">
                    <TextBlock Classes="label" Text="Category" />
                    <ComboBox x:Name="LineCategory"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).CategoryChoices}"
                              SelectedValueBinding="{ReflectionBinding Code}"
                              SelectedValue="{Binding CategoryCode}"
                              AutomationProperties.Name="Line category">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:Choice">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel MinWidth="120">
                    <TextBlock Classes="label" Text="Unit" />
                    <ComboBox x:Name="LineUnit"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).UnitChoices}"
                              SelectedValueBinding="{ReflectionBinding Code}"
                              SelectedValue="{Binding UnitCode}"
                              AutomationProperties.Name="Line unit">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:Choice">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <Button x:Name="RemoveLine"
                          VerticalAlignment="Bottom"
                          Content="Remove"
                          Command="{Binding $parent[ItemsControl].((vm:ReviewViewModel)DataContext).RemoveLineCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="Remove this line" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="AddLine" Content="Add a line" Command="{Binding AddLineCommand}" AutomationProperties.Name="Add a line" />

      <WrapPanel ItemSpacing="12" LineSpacing="8">
        <Button x:Name="Confirm" Classes="accent" Content="Confirm" Command="{Binding ConfirmCommand}" MinWidth="140" AutomationProperties.Name="Confirm this purchase" />
        <Button x:Name="BackFromReview" Content="Back" Command="{Binding BackCommand}" AutomationProperties.Name="Back to home without confirming" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
