<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Expenses.Desktop.Core.Screens"
             x:Class="Expenses.Desktop.Views.CaptureView"
             x:DataType="vm:CaptureViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- While there is no review yet, going back is offered here; once there is, the review offers it. -->
    <DockPanel Grid.Row="0" Margin="24,16,24,0" IsVisible="{Binding Review, Converter={x:Static ObjectConverters.IsNull}}">
      <Button x:Name="BackFromCapture" DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}" AutomationProperties.Name="Back to home without capturing" />
      <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Panel Grid.Row="1">
      <TextBlock x:Name="Uploading" Text="Reading the receipt…" IsVisible="{Binding IsUploading}" Margin="24,16" />

      <StackPanel Spacing="8" Margin="24,16" IsVisible="{Binding UploadFailure, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock x:Name="UploadFailure" Text="{Binding UploadFailure}" TextWrapping="Wrap" />
        <Button x:Name="RetryUpload" Content="Try again" Command="{Binding RetryCommand}" AutomationProperties.Name="Try uploading the receipt again" />
      </StackPanel>

      <ContentControl x:Name="ReviewSlot" Content="{Binding Review}" />
    </Panel>
  </Grid>
</UserControl>
