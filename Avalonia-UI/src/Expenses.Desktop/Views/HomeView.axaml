<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Expenses.Desktop.Core.Screens"
             x:Class="Expenses.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             DragDrop.AllowDrop="True"
             Background="Transparent">
  <!-- A launcher, not a dashboard: the month's one figure, then capture, then the recent few. Only the
       list scrolls, so capture never scrolls away. -->
  <Grid x:Name="Layout" RowDefinitions="Auto,Auto,Auto,*" Margin="24,16">
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="This month" Opacity="0.7" />
      <TextBlock x:Name="MonthTotal"
                 Text="{Binding MonthTotal}"
                 FontSize="28"
                 FontWeight="SemiBold"
                 AutomationProperties.Name="This month's total" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,8">
      <Button x:Name="Capture"
              Classes="accent"
              Content="Capture a receipt"
              Command="{Binding CaptureCommand}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              MinHeight="72"
              FontSize="22"
              AutomationProperties.Name="Capture a receipt" />
      <TextBlock Text="or drop a receipt image onto this window" Opacity="0.7" TextWrapping="Wrap" />
      <TextBlock x:Name="CaptureNotice"
                 Text="{Binding CaptureNotice}"
                 IsVisible="{Binding CaptureNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Grid.Row="2"
               x:Name="ReviewNotice"
               Text="{Binding ReviewNotice}"
               IsVisible="{Binding ReviewNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <!-- The states sit above the list, not layered under it: an overlaid list would take the clicks
         meant for "Try again". -->
    <DockPanel Grid.Row="3">
      <TextBlock DockPanel.Dock="Top" x:Name="Loading" Text="Loading recent purchases…" IsVisible="{Binding IsLoading}" />

      <StackPanel DockPanel.Dock="Top"
                  x:Name="FailurePanel"
                  Spacing="8"
                  IsVisible="{Binding LoadFailure, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock x:Name="LoadFailure" Text="{Binding LoadFailure}" TextWrapping="Wrap" />
        <Button x:Name="Retry" Content="Try again" Command="{Binding RetryCommand}" AutomationProperties.Name="Try loading purchases again" />
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" x:Name="Empty" Text="Nothing recorded yet." IsVisible="{Binding IsEmpty}" />

      <ScrollViewer x:Name="RecentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- An ItemsControl, not a ListBox: entries are information, with no selection, focus or hover
             to suggest they lead anywhere. -->
        <ItemsControl x:Name="Recent" ItemsSource="{Binding Recent}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentPurchaseRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,8" Focusable="False">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock x:Name="RowMerchant" Text="{Binding Merchant}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <WrapPanel ItemSpacing="6">
                    <TextBlock x:Name="RowDetail" Opacity="0.7">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="When" />
                          <Binding Path="Lines" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock x:Name="RowReceipt" Text="· Receipt" Opacity="0.7" IsVisible="{Binding HasReceipt}" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="RowAmount" Text="{Binding Amount}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
