# The FE half of the repo's style rules. BE/.editorconfig covers the .NET side; this file covers
# what Prettier does not (the editor's behaviour before a file is ever formatted) and keeps the
# two halves agreeing on the basics.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[package-lock.json]
insert_final_newline = true
