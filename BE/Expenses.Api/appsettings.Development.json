{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },

  "Cors": {
    // The Vite dev server over HTTP and over FE_HTTPS, and `vite preview`, which the e2e suite
    // drives. Configuration merges arrays by index, and docker-compose.lan.yml adds the phone's LAN
    // origin as index 3: a fourth entry here would silently replace it, so move that index too.
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:4173"
    ]
  }
}
