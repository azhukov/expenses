{
  // Loaded when ASPNETCORE_ENVIRONMENT=Railway. Only what Railway runs with and a reviewer should see
  // here: the connection string, receipt paths and the vision key are Railway service variables.

  "Cors": {
    // The deployed browser client. If Railway regenerates its domain, override this entry with the
    // service variable Cors__AllowedOrigins__0 until this file is updated — index 0 replaces it.
    "AllowedOrigins": [
      "https://expenses-frontend-production-2e52.up.railway.app"
    ]
  },

  "Database": {
    // One API replica and no MCP host on Railway, so nothing races it (D15).
    "ApplyMigrationsOnStartup": true
  }
}
