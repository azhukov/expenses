<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- IDE0005 is a warning in .editorconfig, which makes the compiler demand GenerateDocumentationFile
         (https://github.com/dotnet/roslyn/issues/41640). Turning the doc file on for every build would
         drag in ~960 XML-doc warnings, so the plain build mutes that demand and the dedicated CI step
         ("Unnecessary usings (IDE0005)") builds with -p:GenerateDocumentationFile=true instead. -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only SA1402 (one type per file) is turned on, via .editorconfig; every other StyleCop rule
         is silenced there so pulling in the analyzer doesn't also enable its style opinions. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

</Project>
